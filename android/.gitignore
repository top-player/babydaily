# Gradle wrapper 必须入库：clone 后本机没有 gradle-wrapper.jar，Flutter 也不会自动补，
# 缺了它 ./gradlew 与 flutter build 都会失败。wrapper 是固定版本的官方脚本，不含机器相关信息。
# 注意：这三条曾被忽略（init 起就未入库），要先把文件加进索引，忽略规则的删除才会随提交生效。
!/gradlew
!/gradlew.bat
!/gradle/wrapper/gradle-wrapper.properties
!/gradle/wrapper/gradle-wrapper.jar

/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Gradle 模块构建目录（根 .gitignore 的 /build/ 只锚定项目根目录，覆盖不到这里）
/build/
/app/build/
# Kotlin 2.x 增量编译缓存（android/.kotlin/sessions）
.kotlin/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
